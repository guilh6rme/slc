# =============================================================================
# SLC Digital · IPAJM — Exemplo de Configuração de Ambiente (FastAPI + MySQL)
# Copie este arquivo para backend/.env e preencha os dados do servidor MySQL.
# =============================================================================

# 1. Conexão com o Servidor MySQL de Homologação / Produção (GTI / IPAJM)
DB_HOST=10.x.x.x
DB_PORT=3306
DB_USER=slc_user
DB_PASSWORD=sua_senha_aqui
DB_NAME=slc
DB_CHARSET=utf8mb4

# 2. Configurações da API FastAPI
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

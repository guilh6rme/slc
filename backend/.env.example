# =============================================================================
# SLC Digital · IPAJM — Configuração de Ambiente do Backend (FastAPI + MySQL)
# Copie este arquivo para .env quando for conectar ao servidor MySQL da GTI.
# =============================================================================

# Exemplo de conexão MySQL 8+ (Padrão GTI):
# DATABASE_URL=mysql+pymysql://slc_user:senha_segura@localhost:3306/slc_digital?charset=utf8mb4

# Se DATABASE_URL não for definido ou o servidor MySQL local não estiver ativo
# no momento da demonstração, a API utiliza automaticamente o banco relacional
# embarcado de contingência (slc_digital_local.db) com o mesmo modelo SQLAlchemy.
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

